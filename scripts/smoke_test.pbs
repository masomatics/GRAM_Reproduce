#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -W group_list=gj26
#PBS -N gram_smoke
#PBS -j oe
#PBS -o /work/gj26/b20090/GRAM_Reproduce/wandb_stdout/

set -eu
cd "$HOME"
module load singularity

SIF="$HOME/singularity/pytorch_25.01.sif"
SCRIPT="$HOME/GRAM_Reproduce/scripts/smoke_test.py"

echo "==> host: $(hostname)"
echo "==> sif:  $SIF"
echo "==> py:   $SCRIPT"
nvidia-smi || true

singularity exec --cleanenv --home "$HOME" --nv "$SIF" \
  /bin/bash -c "cd $HOME && python $SCRIPT"
