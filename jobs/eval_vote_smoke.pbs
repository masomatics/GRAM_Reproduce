#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -W group_list=gj26
#PBS -N eval_vote
#PBS -j oe
#PBS -o /work/gj26/b20090/GRAM_Reproduce/wandb_stdout/

# Multi-sample voting eval (paper Sec 2.3, K=20).
# Smoke pass: 8 batches x 768 = 6144 test puzzles, K=20, majority vote.
# Runs against the anti-collapse checkpoint step_65100 (the strongest so far).
# best_of_N is NOT meaningful on the AC ckpt (LPRM weights are zero-init);
# majority vote is the only useful aggregation for this model.

set -eu
GRAM=/work/gj26/b20090/GRAM_Reproduce
AKORN_VENV=/work/gj26/b20090/fast-slow-learning/env_akorn

module purge
module load python/3.10.16
module load cuda/12.6
module load cudnn/9.5.1.17

# shellcheck disable=SC1091
source "$AKORN_VENV/bin/activate"
export PYTHONPATH="$GRAM/env_extra${PYTHONPATH:+:$PYTHONPATH}"

cd "$GRAM"

python scripts/eval_vote.py \
  --checkpoint "$GRAM/checkpoints/gram_sudoku_anticollapse/step_65100" \
  --data "$GRAM/data/sudoku-extreme-1k-aug-1000" \
  --K 20 --strategy majority --N_sup 16 \
  --batch_size 768 --max_batches 8

echo "--- K=1 baseline for same batches ---"
python scripts/eval_vote.py \
  --checkpoint "$GRAM/checkpoints/gram_sudoku_anticollapse/step_65100" \
  --data "$GRAM/data/sudoku-extreme-1k-aug-1000" \
  --K 1 --strategy k1 --N_sup 16 \
  --batch_size 768 --max_batches 8
